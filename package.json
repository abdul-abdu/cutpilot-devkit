{
  "name": "nodcut-plugins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Build plugins for NodCut: the plugin API, the SDK and the first-party plugins (MIT).",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "bundle": "node scripts/bundle-plugin.mjs",
    "nodcut-plugin": "node packages/plugin-sdk/dist/bin.js",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps": "depcruise packages plugins --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm deps && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "dependency-cruiser": "^18.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
