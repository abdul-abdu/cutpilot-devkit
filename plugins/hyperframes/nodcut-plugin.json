{
  "id": "hyperframes",
  "name": "HyperFrames",
  "version": "0.1.2",
  "description": "Research: turns a NodCut edit (kept parts, words, reframe track, a title) into a HyperFrames HTML composition and renders it to MP4 with a local Chrome and ffmpeg. Tools: doctor, compose, lint, render.",
  "publisher": "NodCut",
  "homepage": "https://github.com/nodcut/nodcut-devkit/tree/main/plugins/hyperframes",
  "icon": "icon.png",
  "contract": 1,
  "nodcut": ">=0.1",
  "command": "node",
  "args": ["dist/index.js"],
  "kinds": [],
  "permissions": {
    "network": [],
    "secrets": [],
    "reads": ["source"]
  },
  "settings": [
    {
      "key": "browserPath",
      "label": "Chrome executable (blank: find one)",
      "type": "string",
      "default": ""
    },
    {
      "key": "quality",
      "label": "Render quality",
      "type": "choice",
      "choices": ["draft", "looks", "delivery"],
      "default": "looks"
    },
    {
      "key": "fps",
      "label": "Frames per second",
      "type": "number",
      "default": 30
    }
  ]
}
