{
  "id": "html-motion",
  "name": "HTML Motion",
  "version": "0.1.0",
  "description": "Motion-graphics clips for your edit: title cards, chapter headings, quotes, bullet lists and end cards, made from HTML templates at your video's size and rendered offline with a local Chrome and ffmpeg.",
  "publisher": "CutPilot",
  "homepage": "https://github.com/abdul-abdu/cutpilot-devkit/tree/main/plugins/html-motion",
  "icon": "icon.png",
  "contract": 1,
  "cutpilot": ">=0.1",
  "command": "node",
  "args": ["dist/index.js"],
  "kinds": ["generator"],
  "permissions": {
    "network": [],
    "secrets": [],
    "reads": []
  },
  "settings": [
    {
      "key": "browserPath",
      "label": "Chrome executable (blank: find one)",
      "type": "string",
      "default": ""
    },
    {
      "key": "quality",
      "label": "Render quality",
      "type": "choice",
      "choices": ["draft", "looks", "delivery"],
      "default": "looks"
    }
  ]
}
