{
  "name": "@cutpilot/plugin-sdk",
  "version": "0.1.0",
  "description": "Build CutPilot plugins: definePlugin() and a test harness.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cutpilot-plugin": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "template"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@cutpilot/plugin-api": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdul-abdu/cutpilot-devkit.git",
    "directory": "packages/plugin-sdk"
  },
  "author": "Abdul <abdul.abdurohiym@gmail.com>",
  "keywords": [
    "cutpilot",
    "video",
    "mcp",
    "plugin"
  ],
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/abdul-abdu/cutpilot-devkit/tree/main/packages/plugin-sdk#readme",
  "bugs": {
    "url": "https://github.com/abdul-abdu/cutpilot-devkit/issues"
  }
}
