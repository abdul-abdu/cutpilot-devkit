{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "plugins/*/src/**/*.test.ts",
    "plugins/*.test.ts",
    "scripts/*.test.ts",
    "examples/*.test.ts",
    "scripts/*.d.mts",
    "vitest.config.ts"
  ]
}
